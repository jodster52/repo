    {
      "name": "createBooking",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();\r",
              "console.log(\"New Booking Details: \"+jsonData.booking.firstname+\" \"+jsonData.booking.lastname);\r",
              "console.log(\"New Booking ID: \"+jsonData.bookingid);\r",
              "var bid = jsonData[\"bookingid\"];\r",
              "pm.collectionVariables.set(\"bid\",bid);\r",
              "\r",
              "\r",
              "var bfirst = jsonData[\"booking\"][\"firstname\"];\r",
              "var blast = jsonData[\"booking\"][\"lastname\"];\r",
              "var total = jsonData[\"booking\"][\"totalprice\"];\r",
              "var paid = jsonData[\"booking\"][\"depositpaid\"];\r",
              "var checkin = jsonData[\"booking\"][\"bookingdates\"][\"checkin\"];\r",
              "var checkout = jsonData[\"booking\"][\"bookingdates\"][\"checkout\"];\r",
              "var additional = jsonData[\"booking\"][\"additionalneeds\"];\r",
              "pm.collectionVariables.set(\"fname\",bfirst);\r",
              "pm.collectionVariables.set(\"lname\",blast);\r",
              "pm.collectionVariables.set(\"total\",total);\r",
              "pm.collectionVariables.set(\"paid\",paid);\r",
              "pm.collectionVariables.set(\"checkin\",checkin);\r",
              "pm.collectionVariables.set(\"checkout\",checkout);\r",
              "pm.collectionVariables.set(\"additional\",additional);\r",
              "\r",
              "\r",
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const fname = pm.variables.replaceIn(\"{{$randomFirstName}}\");",
              "const lname = pm.variables.replaceIn(\"{{$randomLastName}}\");",
              "",
              "pm.collectionVariables.set(\"fname\", fname);",
              "pm.collectionVariables.set(\"lname\", lname);",
              "",
              "const future = new Date();",
              "future.setMonth(future.getMonth() + 3);",
              "const chkInDate = future.toISOString().split('T')[0];",
              "pm.collectionVariables.set(\"chkInDate\", chkInDate);",
              "",
              "const checkout = new Date(future);",
              "checkout.setDate(checkout.getDate() + 7);",
              "const chkOutDate = checkout.toISOString().split('T')[0];",
              "pm.collectionVariables.set(\"chkOutDate\", chkOutDate);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Cookie",
            "value": "token={{token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"firstname\" : \"{{fname}}\",\n    \"lastname\" : \"{{lname}}\",\n    \"totalprice\" : 111,\n    \"depositpaid\" : true,\n    \"bookingdates\" : {\n        \"checkin\" : \"{{chkInDate}}\",\n        \"checkout\" : \"{{chkOutDate}}\"\n    },\n    \"additionalneeds\" : \"Breakfast\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseURL}}/booking",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "booking"
          ]
        }
      },
      "response": []
